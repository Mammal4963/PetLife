{
  "name": "petlife",
  "version": "1.0.0",
  "description": "A family timeline and medical record book for our pets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply petlife --remote",
    "db:migrate:local": "wrangler d1 migrations apply petlife --local"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "hono": "^4.6.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
